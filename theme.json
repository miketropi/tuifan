{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": false,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1376px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"custom": true,
			"gradients": [],
			"palette": [
				{
					"slug": "base",
					"name": "Base",
					"color": "oklch(15% 0.006 250)"
				},
				{
					"slug": "surface",
					"name": "Surface",
					"color": "oklch(18% 0.006 250)"
				},
				{
					"slug": "contrast",
					"name": "Contrast",
					"color": "oklch(91% 0.008 250)"
				},
				{
					"slug": "paragraph",
					"name": "Paragraph",
					"color": "oklch(69% 0.009 250)"
				},
				{
					"slug": "border",
					"name": "Border",
					"color": "oklch(33% 0.008 250)"
				},
				{
					"slug": "primary",
					"name": "Primary",
					"color": "oklch(56.954575% 0.10402925 309.958017)"
				},
				{
					"slug": "primary-hover",
					"name": "Primary Hover",
					"color": "oklch(50.954575% 0.10402925 309.958017)"
				},
				{
					"slug": "accent-text",
					"name": "Accent Text",
					"color": "oklch(76% 0.10402925 309.958017)"
				},
				{
					"slug": "on-accent",
					"name": "On Accent",
					"color": "oklch(100% 0 0)"
				},
				{
					"slug": "hover",
					"name": "Hover",
					"color": "oklch(25% 0.008 250)"
				},
				{
					"slug": "secondary",
					"name": "Secondary",
					"color": "oklch(78% 0.12 145)"
				},
				{
					"slug": "warning",
					"name": "Warning",
					"color": "oklch(82% 0.12 85)"
				},
				{
					"slug": "danger",
					"name": "Danger",
					"color": "oklch(78% 0.12 25)"
				},
				{
					"slug": "transparent",
					"name": "Transparent",
					"color": "transparent"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "ibm-plex-mono",
					"name": "IBM Plex Mono",
					"fontFamily": "\"IBM Plex Mono\", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
					"fontFace": [
						{
							"fontFamily": "IBM Plex Mono",
							"fontStyle": "normal",
							"fontWeight": "300",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/ibm-plex-mono/300.ttf"
							]
						},
						{
							"fontFamily": "IBM Plex Mono",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/ibm-plex-mono/400.ttf"
							]
						},
						{
							"fontFamily": "IBM Plex Mono",
							"fontStyle": "normal",
							"fontWeight": "500",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/ibm-plex-mono/500.ttf"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "12px"
				},
				{
					"slug": "base",
					"name": "Base",
					"size": "15px"
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "15px"
				},
				{
					"slug": "medium-plus",
					"name": "Medium Plus",
					"size": "18px"
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "22px"
				},
				{
					"slug": "x-large",
					"name": "Extra Large",
					"size": "32px"
				},
				{
					"slug": "xx-large",
					"name": "Extra Extra Large",
					"size": "44px"
				},
				{
					"slug": "hero",
					"name": "Hero",
					"size": "clamp(46px, 6.7vw, 112px)",
					"fluid": false
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [
				"px",
				"em",
				"rem",
				"%",
				"vh",
				"vw"
			],
			"spacingSizes": [
				{
					"slug": "05",
					"name": "05",
					"size": "8px"
				},
				{
					"slug": "10",
					"name": "10",
					"size": "16px"
				},
				{
					"slug": "15",
					"name": "15",
					"size": "20px"
				},
				{
					"slug": "20",
					"name": "20",
					"size": "24px"
				},
				{
					"slug": "30",
					"name": "30",
					"size": "32px"
				},
				{
					"slug": "40",
					"name": "40",
					"size": "48px"
				},
				{
					"slug": "50",
					"name": "50",
					"size": "64px"
				},
				{
					"slug": "60",
					"name": "60",
					"size": "80px"
				},
				{
					"slug": "70",
					"name": "70",
					"size": "96px"
				}
			]
		}
	},
	"customTemplates": [
		{
			"name": "about-us",
			"title": "About Us",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-full-width",
			"title": "Page — Full Width",
			"description": "A page with a wider terminal shell",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "contact-us",
			"title": "Contact Us",
			"description": "A page with the Tuifan disconnected contact template",
			"postTypes": [
				"page"
			]
		}
	],
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		},
		{
			"name": "footer-newsletter",
			"title": "Footer Newsletter",
			"area": "uncategorized"
		},
		{
			"name": "sidebar",
			"title": "Sidebar",
			"area": "uncategorized"
		},
		{
			"name": "comments",
			"title": "Comments",
			"area": "uncategorized"
		}
	],
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--paragraph)"
		},
		"blocks": {
			"core/group": {
				"spacing": {
					"padding": {
						"top": "0",
						"right": "0",
						"bottom": "0",
						"left": "0"
					}
				}
			},
			"core/heading": {
				"typography": {
					"fontWeight": "300",
					"lineHeight": "1.4"
				},
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "0"
					}
				}
			},
			"core/paragraph": {
				"typography": {
					"lineHeight": "1.7"
				},
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "0"
					}
				}
			},
			"core/list": {
				"typography": {
					"lineHeight": "1.7"
				},
				"spacing": {
					"padding": {
						"left": "24px"
					},
					"margin": {
						"top": "0",
						"bottom": "0"
					}
				}
			},
			"core/quote": {
				"border": {
					"top": {
						"width": "1px",
						"style": "solid",
						"color": "var(--wp--preset--color--border)"
					},
					"right": {
						"width": "1px",
						"style": "solid",
						"color": "var(--wp--preset--color--border)"
					},
					"bottom": {
						"width": "1px",
						"style": "solid",
						"color": "var(--wp--preset--color--border)"
					},
					"left": {
						"width": "1px",
						"style": "solid",
						"color": "var(--wp--preset--color--border)"
					}
				},
				"color": {
					"background": "var(--wp--preset--color--surface)",
					"text": "var(--wp--preset--color--contrast)"
				},
				"typography": {
					"fontSize": "15px",
					"fontStyle": "normal",
					"lineHeight": "1.85"
				},
				"spacing": {
					"padding": {
						"top": "24px",
						"right": "24px",
						"bottom": "24px",
						"left": "24px"
					},
					"margin": {
						"top": "0",
						"bottom": "0"
					}
				}
			},
			"core/code": {
				"color": {
					"background": "var(--wp--preset--color--surface)",
					"text": "var(--wp--preset--color--contrast)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--ibm-plex-mono)",
					"fontSize": "13px",
					"lineHeight": "1.8"
				},
				"spacing": {
					"padding": {
						"top": "20px",
						"right": "20px",
						"bottom": "20px",
						"left": "20px"
					},
					"margin": {
						"top": "0",
						"bottom": "0"
					}
				}
			},
			"core/preformatted": {
				"color": {
					"background": "transparent",
					"text": "var(--wp--preset--color--contrast)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--ibm-plex-mono)",
					"fontSize": "13px",
					"lineHeight": "1.85"
				},
				"spacing": {
					"padding": {
						"top": "0",
						"right": "0",
						"bottom": "0",
						"left": "0"
					},
					"margin": {
						"top": "0",
						"bottom": "0"
					}
				}
			},
			"core/table": {
				"typography": {
					"fontSize": "13px",
					"lineHeight": "1.7"
				},
				"border": {
					"width": "1px",
					"style": "solid",
					"color": "var(--wp--preset--color--border)"
				}
			}
		},
		"typography": {
			"fontFamily": "var(--nextora-font-body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "400",
			"lineHeight": "1.7"
		},
		"spacing": {
			"padding": {
				"top": "0",
				"right": "0",
				"bottom": "0",
				"left": "0"
			},
			"blockGap": "0"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				},
				"typography": {
					"fontFamily": "var(--nextora-font-heading)",
					"fontWeight": "300",
					"lineHeight": "1.4",
					"letterSpacing": "-0.02em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "clamp(32px, 4vw, 44px)",
					"fontWeight": "300",
					"lineHeight": "1.15",
					"letterSpacing": "-0.025em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "22px",
					"fontWeight": "300",
					"lineHeight": "1.4"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "18px",
					"fontWeight": "300",
					"lineHeight": "1.4"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "16px",
					"fontWeight": "500",
					"lineHeight": "1.45"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "15px",
					"fontWeight": "500",
					"lineHeight": "1.5"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "13px",
					"fontWeight": "500",
					"lineHeight": "1.5",
					"letterSpacing": "0.04em"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent-text)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--contrast)"
					}
				}
			},
			"button": {
				"border": {
					"radius": "0",
					"width": "1px",
					"style": "solid",
					"color": "var(--wp--preset--color--primary)"
				},
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--on-accent)"
				},
				"typography": {
					"fontFamily": "var(--nextora-font-heading)",
					"fontSize": "13px",
					"fontWeight": "500",
					"letterSpacing": "0.02em"
				},
				"spacing": {
					"padding": {
						"top": "12px",
						"right": "20px",
						"bottom": "12px",
						"left": "20px"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary-hover)",
						"text": "var(--wp--preset--color--on-accent)"
					}
				},
				":focus": {
					"outline": {
						"width": "2px",
						"style": "solid",
						"color": "var(--wp--preset--color--contrast)"
					}
				}
			},
			"caption": {
				"typography": {
					"fontSize": "12px",
					"lineHeight": "1.7"
				},
				"color": {
					"text": "var(--wp--preset--color--paragraph)"
				}
			}
		}
	}
}
