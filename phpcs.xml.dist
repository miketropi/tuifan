<?xml version="1.0"?>
<ruleset name="Tuifan">
	<description>Dev-only coding standards for the Tuifan child theme (procedural PHP, no classes).</description>

	<!-- Whole theme, minus generated/third-party output. -->
	<file>./</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/assets/*</exclude-pattern>
	<!--
		`*.asset.php` is generated by the @wordpress/scripts build (dependency
		manifest): hyphenated filenames, a file doc comment and one-item-per-line
		arrays would all be overwritten on the next `npm run build`.
	-->
	<exclude-pattern>*.asset.php</exclude-pattern>

	<!-- Only real PHP source; show progress, sources and a summary. -->
	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg value="ps"/>
	<arg name="colors"/>

	<!--
		minimum_wp_version lets WPCS gate WordPress-version-specific APIs at WP 6.6.
		testVersion is the PHP floor: the theme's style.css declares
		`Requires PHP: 8.1`, and the PHP uses PHP 8 string helpers (str_contains()).
	-->
	<config name="minimum_wp_version" value="6.6"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress"/>
	<rule ref="WordPress-Core"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="WordPress-Extra"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- Every global this theme declares is prefixed `tuifan_`. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" value="tuifan"/>
		</properties>
	</rule>

	<!-- The child theme is English-only source; all strings use the `tuifan` domain. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" value="tuifan"/>
		</properties>
	</rule>
</ruleset>
